{
  "name": "@tax-intelligence/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "prebuild": "prisma generate --schema ../../packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema ../../packages/database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema ../../packages/database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "@nestjs/throttler": "^6.4.0",
    "helmet": "^8.1.0",
    "@nestjs/swagger": "^12.1.2",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "@types/jest": "^29.5.14",
    "prisma": "^6.5.0"
  }
}
