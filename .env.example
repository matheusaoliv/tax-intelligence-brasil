# API
PORT=3001
NODE_ENV=development

# Database and queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tax_intelligence?schema=public
REDIS_URL=redis://localhost:6379

# Object storage (configure only in deployment secret manager)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Authentication secrets must be generated per environment.
AUTH_SESSION_SECRET=
