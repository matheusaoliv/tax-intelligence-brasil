# API
PORT=3001
POSTGRES_PASSWORD=change-this-local-password
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SAME_SITE=lax
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NODE_ENV=development

# Database and queue
DATABASE_URL=postgresql://tax_app:change-this-local-password@localhost:5432/tax_intelligence?schema=public
REDIS_URL=redis://localhost:6379

# Upstream fiscal engines (private internal services)
REGIME_REGULAR_ENGINE_URL=http://127.0.0.1:8080
SIMPLES_NACIONAL_ENGINE_URL=http://127.0.0.1:8082
SIMPLES_DB_DOWNLOAD_URL=

# Object storage (configure only in deployment secret manager)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256

# DANFSe service
DANFSE_ENGINE_URL=http://127.0.0.1:8083
XML_MAX_SIZE_BYTES=5242880
JSON_BODY_LIMIT=7mb

# 32-byte base64 key for encrypting tax identifiers at rest
DATA_ENCRYPTION_KEY=
